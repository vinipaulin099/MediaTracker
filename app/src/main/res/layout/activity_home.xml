<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <Button android:id="@+id/back_button" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/back_collection" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp"
        android:text="@string/catalog_title" android:textSize="28sp" android:accessibilityHeading="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="16dp"
        android:text="@string/catalog_description" android:textSize="16sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list_view"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="16dp" />
</LinearLayout>
